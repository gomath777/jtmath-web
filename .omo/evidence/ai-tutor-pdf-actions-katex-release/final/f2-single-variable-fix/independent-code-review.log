const LATEX_COMMAND = /\\([A-Za-z]+)/g;
const ALLOWED_LATEX_COMMANDS = new Set([
  'alpha',
  'angle',
  'approx',
  'beta',
  'binom',
  'cap',
  'cdot',
  'circ',
  'cos',
  'cot',
